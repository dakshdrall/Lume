# Public site URL (used for magic-link redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile — these are Cloudflare's official "always passes" test keys.
# Replace with real keys from the Cloudflare dashboard before launch.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin dashboard: comma-separated list of emails allowed to sign in to /admin
ADMIN_EMAILS=you@example.com

# Waitlist rate limit (signups per IP per hour) and salt used to hash IPs
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_SALT=change-me-to-a-long-random-string

# Contact email shown in the footer and legal pages
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
